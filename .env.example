# Web UI
WTUI_PORT=8085
TZ=Europe/Berlin

# Persistent application data. Keep this path stable across image updates/redeploys.
# It contains SQLite state, logs and automatic pre-update backups.
WTUI_DATA_PATH=./data

# Owner account (login name: admin, role: Owner)
# CHANGE BOTH BEFORE FIRST START
WTUI_ADMIN_PASSWORD=replace-with-a-strong-password
WTUI_SESSION_SECRET=replace-with-a-long-random-secret

# Logging: TRACE, DEBUG, INFO, WARN, ERROR
WTUI_LOG_LEVEL=INFO

# Nicholas Fedor Watchtower fork used by centrally managed workers.
# Workers remain passive; the controller explicitly disables periodic polling.
WTUI_WATCHTOWER_IMAGE=nickfedor/watchtower:latest

# Pushover.net credentials are configured per Vibewatch account in Settings.
# Legacy installations may keep PUSHOVER_APP_TOKEN in their existing .env for
# one-time Owner migration, but new installations do not need a shared token.

# Optional GitHub API token for higher rate limits/private release notes.
GITHUB_TOKEN=

# Self-update support. Leave empty while building locally. Once the project is
# published, set this to the exact image used by Compose, e.g.:
# WTUI_APP_IMAGE=ghcr.io/OWNER/vibewatch:latest
WTUI_APP_IMAGE=

# Note: WTUI_* variable names are legacy compatibility aliases retained in V0.4.5.
# Docker runtime objects themselves are named Vibewatch (`vibewatch`,
# `vibewatch-worker-*`, `vibewatch-internal`).
