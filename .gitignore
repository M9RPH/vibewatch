# Environment / secrets
.env
.env.*
!.env.example

# Script-local secrets
scripts/.env

# Runtime data
data/*
!data/.gitkeep
!data/backups/
!data/backups/.gitkeep
!data/backups/bundles/
!data/backups/bundles/.gitkeep
!data/backups/containers/
!data/backups/containers/.gitkeep
!data/logs/
!data/logs/.gitkeep
!data/host-tls/
!data/host-tls/.gitkeep

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated backups / snapshots
backups/
snapshots/
data/backups/*
!data/backups/.gitkeep
!data/backups/bundles/
!data/backups/bundles/.gitkeep
!data/backups/containers/
!data/backups/containers/.gitkeep
data/snapshots/

*.tar
*.tar.gz
*.tgz
*.zip

# Logs
*.log
*.jsonl
logs/
data/logs/*
!data/logs/.gitkeep

# TLS/mTLS client material
data/host-tls/*
!data/host-tls/.gitkeep

