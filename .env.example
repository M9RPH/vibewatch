# Vibewatch web UI
VIBEWATCH_PORT=8085
TZ=Europe/Berlin

# Persistent application data. Keep this path stable across image updates/redeploys.
# It contains SQLite state, logs, recovery metadata and controller backups.
VIBEWATCH_DATA_PATH=./data

# Owner account (login name: admin, role: Owner)
# CHANGE BOTH BEFORE FIRST START
VIBEWATCH_ADMIN_PASSWORD=replace-with-a-strong-password
VIBEWATCH_SESSION_SECRET=replace-with-a-long-random-secret

# Logging: TRACE, DEBUG, INFO, WARN, ERROR
VIBEWATCH_LOG_LEVEL=INFO

# Nicholas Fedor Watchtower fork used by centrally managed workers.
# Workers remain passive; Vibewatch owns scheduling and update safety.
VIBEWATCH_WATCHTOWER_IMAGE=nickfedor/watchtower:latest

# Optional GitHub API token for higher rate limits/private release notes.
GITHUB_TOKEN=

# Published Vibewatch image used by the official Compose installation and self-update.
# Pin a release for predictable upgrades; use latest only if you intentionally want it.
VIBEWATCH_APP_IMAGE=ghcr.io/m9rph/vibewatch:0.9.5

# Compatibility: existing pre-rebrand WTUI_* variables are still accepted as
# fallbacks in v0.9.5. New installations should use VIBEWATCH_* only.
